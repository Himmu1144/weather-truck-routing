{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*/",
      "destination": "https://spotter-api-551661410853.us-central1.run.app/api/:path*/"
    },
    {
      "source": "/api/:path*",
      "destination": "https://spotter-api-551661410853.us-central1.run.app/api/:path*"
    }
  ]
}
